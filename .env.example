# ElevenLabs TTS — used by scripts/generate-tts.ts
# Get your API key from https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=sk-your-key-here

# Hindi voice ID — find voices at https://elevenlabs.io/app/voice-library
# Recommended: search for "Hindi" in the voice library
ELEVENLABS_VOICE_ID=your-voice-id-here
