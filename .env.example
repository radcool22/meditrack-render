# ── ElevenLabs TTS (used by scripts/generate-tts.ts) ─────────────
ELEVENLABS_API_KEY=sk-your-key-here
ELEVENLABS_VOICE_ID=your-voice-id-here

# ── Server ────────────────────────────────────────────────────────
PORT=3000
RENDER_API_KEY=dev-key

# ── Redis (Upstash or local) ─────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Cloudflare R2 ────────────────────────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=meditrack-videos
R2_PUBLIC_BASE_URL=

# ── OpenAI ────────────────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# ── ElevenLabs for server pipeline (prompt B) ────────────────────
ELEVENLABS_VOICE_ID_HI=
